# !.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# debug & logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# editors & local AI/tool scratch
.vscode/*
